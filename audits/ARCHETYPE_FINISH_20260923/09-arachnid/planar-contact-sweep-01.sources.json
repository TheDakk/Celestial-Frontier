      "needle": "  if(padDeclaration){",
      "insertion": "  (globalThis as any).__planarSweepTrace?.('targets',{phase,stance,pose,contacts,activeChains:activeChains.map(c=>({id:c.id,endpointOnly:c.endpointOnly}))});\n"
