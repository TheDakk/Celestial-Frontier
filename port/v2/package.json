{
  "name": "cf-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Celestial Frontier v2 port — TypeScript workspace with isolated game/runtime and evidence-tool dependencies.",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "workspaces": [
    "packages/domain/*",
    "packages/persistence",
    "packages/scene",
    "packages/art",
    "packages/audio",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/game/tsconfig.json && tsc --noEmit -p apps/game/tsconfig.worker.json",
    "artunused": "tsc --noEmit --noUnusedLocals",
    "smoke": "node tools/slicesmoke.mjs",
    "arc4recovery": "node tools/arc4recovery.mjs",
    "arc4recovery:selftest": "node tools/arc4recovery.mjs --selftest",
    "smoke:ci": "node tools/smokereport.mjs",
    "smoke:report:selftest": "node tools/smokereport.mjs --selftest",
    "glassmatrix": "node tools/glassmatrix.mjs",
    "glassmatrix:selftest": "node tools/glassmatrix.mjs --selftest",
    "compendiummem": "node tools/compendiummem.mjs",
    "compendiummem:selftest": "node tools/compendiummem.mjs --selftest",
    "compendiummem:calibrate": "node tools/compendiummem.mjs --calibrate",
    "persona:report": "node tools/personaplaytest.mjs",
    "persona:selftest": "node tools/personaplaytest.mjs --selftest",
    "preview:package": "node tools/devpreview.mjs",
    "preview:verify": "node tools/devpreview.mjs",
    "preview:smoke": "node tools/devpreviewcheck.mjs",
    "preview:selftest": "node tools/devpreview.mjs --selftest && node tools/devpreviewcheck.mjs --selftest",
    "proofsheet": "node tools/proofsheet.mjs",
    "perf": "node tools/sliceperf.mjs",
    "speciesaudit": "node tools/speciesaudit.mjs",
    "speciesexport": "node tools/speciesexport.mjs",
    "hybridcheck": "node tools/hybridblendcheck.mjs",
    "hybridmatrix": "node tools/hybridmatrix.mjs",
    "currentreviewpackage": "node tools/currentreviewpackage.mjs",
    "gliderreview": "node tools/gliderreview.mjs",
    "gp71compare": "node tools/gp71compare.mjs",
    "fullresetlayout": "node tools/fullresetlayout.mjs",
    "fullresetreview": "node tools/fullresetreview.mjs",
    "cataloguecards": "node tools/rejudgecards.mjs --drift=reference/goldpass3-prechassis.json --out=catalogue-review --full",
    "stripcheck": "node tools/speciesstrip.mjs --selftest",
    "gp7collect": "node tools/gp7collect.mjs",
    "gp7conformity": "node tools/gp7conformity.mjs",
    "gp7package": "node tools/gp7package.mjs",
    "overridecheck": "node tools/overridecheck.mjs",
    "strip": "node tools/speciesstrip.mjs",
    "overridecontrol": "node tools/overridecheck.control.mjs",
    "coveragegap": "node tools/coveragegap.mjs",
    "artaudit": "node tools/artaudit.mjs",
    "artbattery": "node tools/artbattery.mjs"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "jsdom": "^29.1.1",
    "rolldown": "1.2.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "ws": "^8.18.3"
  }
}
